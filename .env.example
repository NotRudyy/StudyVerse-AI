# Copy to .env for local Docker Compose. Demo mode runs without API keys.
DEMO_MODE=true
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
DATABASE_URL=postgresql+asyncpg://studyverse:studyverse@localhost:5432/studyverse
REDIS_URL=redis://localhost:6379/0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
USE_VERTEX_AI=false
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_PROJECT=
GCS_BUCKET=
GOOGLE_APPLICATION_CREDENTIALS=
JWT_SECRET=replace-with-a-long-random-value-before-deployment
CORS_ORIGINS=["http://localhost:3000"]
